# Короткие адреса и серверная подстановка превью (Apache-хостинг, InfinityFree)
DirectoryIndex index.php index.html
AddType application/manifest+json .webmanifest
RewriteEngine On
# Папки admin/ и golos/ (для GitHub Pages) не должны перехватывать адреса /admin и /golos: без этого mod_dir добавляет слэш и получается цикл редиректов
DirectorySlash Off
RewriteRule ^admin/$ /admin [R=301,L]
RewriteRule ^admin$ admin.html [L]
RewriteRule ^golos/$ /golos [R=301,L]
RewriteRule ^golos$ golos.html [L]
RewriteRule ^press/$ /press [R=301,L]
RewriteRule ^press$ press.html [L]
RewriteRule ^reviews/$ /reviews [R=301,L]
RewriteRule ^reviews$ reviews.html [L]
# Адреса без .html: /play/<id> и /actor/<slug>. Старые play.html?id=… отвечают 301 на новые
RewriteCond %{QUERY_STRING} ^id=([\w-]+)$
RewriteRule ^play\.html$ /play/%1? [R=301,L]
RewriteCond %{QUERY_STRING} ^id=([\w-]+)&(.+)$
RewriteRule ^play\.html$ /play/%1?%2 [R=301,L]
RewriteCond %{QUERY_STRING} ^id=([\w-]+)$
RewriteRule ^actor\.html$ /actor/%1? [R=301,L]
RewriteCond %{QUERY_STRING} ^id=([\w-]+)&(.+)$
RewriteRule ^actor\.html$ /actor/%1?%2 [R=301,L]
RewriteRule ^play/([\w-]+)/?$ play.php?id=$1 [L,QSA]
RewriteRule ^actor/([\w-]+)/?$ actor.php?id=$1 [L,QSA]
# Относительные пути со страниц /play/… и /actor/… (assets, photos, api.php, sw.js) ведут в корень
RewriteRule ^(?:play|actor)/(.+[./].+)$ /$1 [L]
RewriteCond %{DOCUMENT_ROOT}/play.php -f
RewriteRule ^play\.html$ play.php [L,QSA]
RewriteCond %{DOCUMENT_ROOT}/actor.php -f
RewriteRule ^actor\.html$ actor.php [L,QSA]
RewriteCond %{DOCUMENT_ROOT}/calendar.php -f
RewriteRule ^calendar\.ics$ calendar.php [L]
RewriteCond %{DOCUMENT_ROOT}/sitemap.php -f
RewriteRule ^sitemap\.xml$ sitemap.php [L]
ErrorDocument 404 /404.html

# Кэш: страницы всегда свежие, статика с версией в адресе кэшируется надолго
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|png|svg|jpg|jpeg|webp|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
