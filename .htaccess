# Короткие адреса и серверная подстановка превью (Apache-хостинг, InfinityFree)
DirectoryIndex index.php index.html
RewriteEngine On
RewriteRule ^admin/$ /admin [R=301,L]
RewriteRule ^admin$ admin.html [L]
RewriteRule ^golos/$ /golos [R=301,L]
RewriteRule ^golos$ golos.html [L]
RewriteCond %{DOCUMENT_ROOT}/play.php -f
RewriteRule ^play\.html$ play.php [L,QSA]

# Кэш: страницы всегда свежие, статика с версией в адресе кэшируется надолго
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|png|svg|jpg|jpeg|webp|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
